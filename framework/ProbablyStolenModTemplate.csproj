<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameManaged)/0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManaged)/Assembly-CSharp.dll') Or !Exists('$(GameManaged)/0Harmony.dll') Or !Exists('$(GameManaged)/UnityEngine.CoreModule.dll')"
           Text="Set GameManaged to the target game's Probably Stolen_Data/Managed directory." />
  </Target>
</Project>
